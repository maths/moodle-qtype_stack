      <text><![CDATA[/*Written by Meike Akveld, George Ionita, Andreas Steiger, ETH Zürich
Contact and more information:
stack@math.ethz.ch - www.math.ethz.ch/stack*/
/*Author: Michael Kallweit, Ruhr Universität Bochum
You find further information on our website:
https://www.ruhr-uni-bochum.de/hdm/stack.en.shtml*/
texput(multsgnonlyfornumberssym, "\\cdot");
n:4;
zero1:rand([-1,2]); /*DOUBLE ROOT - 2 possibilities*/
zero2:rand_with_prohib(-3,3,[0,1,zero1]); /*SIMPLE ROOT - 4 possibilities*/
zero3:rand_with_prohib(-3,3,[0,1,zero1,zero2]); /*SIMPLE ROOT - 3 possibilities*/
/*24/2 = 12 variants in total*/
nst:([zero1, zero1, zero2, zero3]);
p:expand(apply("*",makelist((x-nst[i]),i,1,n)));
ta:nst;
poly:expand(p);]]></text>
    </questionvariables>
