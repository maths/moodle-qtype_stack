      <feedbackstyle>1</feedbackstyle>
      <feedbackvariables>
        <text><![CDATA[/* An equation is described by the set of its solutions for each of its variables.
   Equations without a solution for a variable get the solution nosolution there. */
solveforvars(eq) := block([sols, s],
    sols: [],
    for var in listofvars(eq) do (
        s: errcatch(solve(eq, var)),
        if s # [] and listp(first(s)) and first(s) # [] and is(op(first(first(s))) = "=")
        then sols: cons(rhs(first(first(s))), sols)
        else sols: cons(nosolution, sols)
    ),
    setify(sols)
);
rowsets: map(solveforvars, repeatedans3);
T1: setify(map(solveforvars, ta3));
T2: setify(map(solveforvars, ta3alt1));
n1: cardinality(intersection(setify(rowsets), T1));
n2: cardinality(intersection(setify(rowsets), T2));
/* Compare with the system using the sign of lambda which more equations use. */
T: if n2 > n1 then T2 else T1;
ncorrect: max(n1, n2);
wrongrows: sublist_indices(rowsets, lambda([s], not elementp(s, T)));
wrongrowstext: if length(wrongrows) > 1 then sconcat(simplode(map(string, rest(wrongrows, -1)), ", "), " and ", string(last(wrongrows))) else "";
othervars: setdifference(setify(listofvars(repeatedans3)), {x, y, z, lambda});
/* A quarter of the marks for each equation of the system, minus a quarter for each wrong equation. */
sc: max(0, ncorrect/4 - length(wrongrows)/4);]]></text>
