<quiz>
  <question type="stack">
    <name>
      <text>Characteristic polynomial and eigenvalues</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Let \[ A = {@AA@}. \]</p>
<p>(a) Find the characteristic polynomial \(p(x) = \det(xI - A)\).</p>
<div>\(p(x) = \) [[input:ans1]] [[validation:ans1]]</div>
<div>[[feedback:prt1]]</div>
<p>(b) Find the eigenvalues of \(A\). Enter them as a set, for example <code>{1, -2, 3}</code>.</p>
<div>[[input:ans2]] [[validation:ans2]]</div>
<div>[[feedback:prt2]]</div>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>(a) Expanding the determinant gives \(p(x) = \det(xI - A) = {@ta1@}\).</p>
<p>(b) The eigenvalues are the roots of \(p\). Here \(p(x) = {@product(x - dd[k], k, 1, 3)@}\), so the eigenvalues are \({@ta2@}\).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2026111900</text>
    </stackversion>
    <questionvariables>
      <text>stack_include_contrib("validators.mac");
validate_px(ex) := validate_poly(ex, [x]);
/* Build backwards: A = P.D.P^^-1, with P an integer matrix of determinant 1, so A has integer entries. */
/* Over every choice the largest entry of A is 12. */
PP: rand([matrix([1,1,0],[0,1,1],[0,0,1]), matrix([1,0,0],[1,1,0],[0,1,1]), matrix([1,0,1],[0,1,0],[1,1,2])]);
dd: rand_selection([-3,-2,-1,1,2,3], 3);
AA: PP . apply(diag_matrix, dd) . PP^^-1;
ta1: expand((x - dd[1])*(x - dd[2])*(x - dd[3]));
ta2: setify(dd);</text>
    </questionvariables>
