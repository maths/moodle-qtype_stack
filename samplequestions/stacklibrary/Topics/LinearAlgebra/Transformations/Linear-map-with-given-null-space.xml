      <feedbackvariables>
        <text>F: [ans1, ans2];
/* Linear: constant partial derivatives, and T(0) = 0. */
lin: is(listofvars(jacobian(F, X)) = []) and is(expand(subst(map(lambda([v], v = 0), X), F)) = [0, 0]);
/* coefmatrix ignores constant and non-linear terms, so use it only once lin is true. */
MB: if lin then coefmatrix(F, X) else zeromatrix(2, 2);
ker: is(MB . nv = zeromatrix(2, 1));
rk: is(rank(MB) = 1);</text>
