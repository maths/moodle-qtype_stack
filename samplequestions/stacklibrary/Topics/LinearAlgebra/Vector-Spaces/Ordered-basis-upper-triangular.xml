      <feedbackvariables>
        <text>/* A list keeps the order; convert each c(...) to a list of entries. */
sl: map(lambda([v], list_matrix_entries(vec_convert(v))), ans1);
three: is(length(sl) = 3);
QQ: if three then transpose(apply(matrix, sl)) else ident(3);
inv: three and is(determinant(QQ) # 0);
TT: if inv then ratsimp(QQ^^-1 . AA . QQ) else zeromatrix(3, 3);
up: triup(TT);</text>
