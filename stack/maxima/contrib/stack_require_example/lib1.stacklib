        "\/stack\/maxima\/contrib\/stack_require_example\/lib1b.mac": {
            "sha1": "23bc610255919fb7f0facec135b026a0936f02c6"
        }
    },
    "contents": {
        "preamble \/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac": {
            "requires": [],
            "code": "texput(\"lib1_item\",lambda([ex],sconcat(\"\\\\sqrt{\",first(ex),\"}\")));\n"
        },
        "lib1a_fun1": {
            "requires": [
                "local\/preamble \/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac",
                "lib2\/lib2_fun2"
            ],
            "src": "\/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac",
            "code": "lib1a_fun1(mode):=if mode then sconcat(\"1\/fun1, \",lib2_fun2(true)) else \"1\/fun1\";\n"
        },
        "lib1a_fun2": {
            "requires": [
                "local\/preamble \/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac"
            ],
            "src": "\/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac",
            "code": "lib1a_fun2(mode):=\"1\/fun2\";\n"
        },
        "lib1a_value1": {
            "requires": [
                "local\/preamble \/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac",
                "local\/lib1b_value1"
            ],
            "src": "\/stack\/maxima\/contrib\/stack_require_example\/lib1a.mac",
            "code": "lib1a_value1:lib1b_value1;\n"
        },
        "lib1b_value1": {
            "requires": [],
            "src": "\/stack\/maxima\/contrib\/stack_require_example\/lib1b.mac",
            "code": "lib1b_value1:lib1_item(2);\n"
        }
    },
    "tests": [
        {
            "code": "s_test_case(simp):=is(lib1a_fun1(false) = \"1\/fun1\");\n",
            "requires": [
                "local\/lib1a_fun1"
            ]
        },
        {
            "code": "s_test_case(simp):=is(lib1a_fun1(true) = \"1\/fun1, 2\/fun2, 1\/fun2\");\n",
            "requires": [
                "local\/lib1a_fun1"
            ]
        },
        {
            "code": "s_test_case(simp):=is(tex1(lib1b_value) = \"{\\\\it lib1\\\\_item}\\\\left(2\\\\right)\");\n",
            "requires": []
        },
        {
            "code": "s_test_case(simp):=block([],is(tex1(lib1b_value) = \"{\\\\it lib1\\\\_item}\\\\left(2\\\\right)\"));\n",
            "requires": [
                "local\/lib1a_value1"
            ]
        }
    ]
