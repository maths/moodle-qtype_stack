/****************************************************************/
/*  Bespoke validators for STACK inputs                         */
/*                                                              */
/*  Chris Sangwin, <C.J.Sangwin@ed.ac.uk>                       */
/*  V1.0 June 2023                                              */
/*                                                              */
/*  Please use this file to add public bespoke validators.      */
/*                                                              */
/****************************************************************/

/* The student may not use an underscore anywhere in their input. */

validate_underscore(ex) := if is(sposition("_", string(ex)) = false) then "" 
        else "Underscore characters are not permitted in this input.";

/* Add in unit-test cases using STACK's s_test_case function.  At least two please! */
/* Place test cases in validators_test.mac                                          */

/* The student may not use a user-defined function, or arrays, anywhere in their input. */
validate_nofunctions(ex):= block([op1,opp],
  if atom(ex) then return(""),
  op1:ev(op(ex)),
  opp:apply(properties, [op1]),
  if ev(emptyp(opp) or is(opp=[noun]),simp) then return(sconcat("User-defined functions are not permitted in this input. In your answer ", stack_disp(op1, "i"), " appears to be used as a function. ")),
  apply(sconcat, map('validate_nofunctions, args(ex)))
);

/* The student may only use single-character variable names in their answer. */
/* This is intended for use when Insert Stars is turned off, but we still want to indicate to students that they may have forgotten a star */
validate_all_one_letter_variables(ex) := if not(is(ev(lmax(map(lambda([ex2],slength(string(ex2))),listofvars(ex))),simp)>1)) then ""
        else "Only single-character variable names are permitted in this input. Perhaps you forgot to use an asterisk (*) somewhere, or perhaps you used a Greek letter.";

/* This provides more detailed feedback for students who try to enter fully closed or open intervals using [] or () instead of cc(a,b) or oo(a,b). */
/* It is intended for early courses where students might be new to using this written notation and STACK. */
/* This does not work well with "Check type of response" turned on, and provides slightly awkward feedback when students take a union of multiple intervals with incorrect syntax. */
validate_interval_syntax(ex):= block(
  if ev(listp(ex),simp) then return(sconcat("To give a closed interval, use <code>cc(",first(args(ex)),",",second(args(ex)),")</code>, not <code>[",first(args(ex)),",",second(args(ex)),"]</code>. "))
  else if ev(ntuplep(ex),simp) then return(sconcat("To give an open interval, use <code>oo(",first(args(ex)),",",second(args(ex)),")</code>, not <code>(",first(args(ex)),",",second(args(ex)),")</code>. "))
  else if is(safe_op(ex)="%union") then apply(sconcat, map('validate_interval_syntax, args(ex)))
  else return("")
);

/****************************************************************/
/*  Validators for linear algebra                               */
/*                                                              */
/*  Validators run with simp:false.  Each of these checks for   */
/*  variables in the unsimplified answer, so 0*t is rejected,   */
/*  and tests each entry with a predicate which simplifies, so  */
/*  sqrt(-4) is rejected where real numbers are required.       */
/*                                                              */
/*  The plain versions require real numbers and reject i.       */
/*  The _c versions allow complex numbers.                      */
/*  For a single number, use the numerical input with the       */
/*  realnum option instead of a validator.                      */
/*                                                              */
/*  A validator takes one argument, so a validator which takes  */
/*  a size or a list of variables is wrapped in the question    */
/*  variables, e.g. validate_vecset3(ex) := validate_vecset(ex, 3); */
/****************************************************************/

/* Is x a number, possibly complex?  simp_complex_number_p((1+2*%i)/3) is false, so test the parts. */
validate_la_complexp(x) := block([r],
  r: errcatch(ev([realpart(x), imagpart(x)], simp)),
  if emptyp(r) then return(false),
  real_numberp(first(first(r))) and real_numberp(second(first(r))));

/* Is every element of the list L a number of the kind mode: "real", "complex" or "rational"? */
validate_la_entriesp(L, mode) := is(listofvars(L) = []) and
  every(lambda([x],
    if is(mode = "complex") then validate_la_complexp(x)
    else if is(mode = "rational") then ratnump(ev(x, simp))
    else real_numberp(x)), L);

validate_la_entries_msg(mode) :=
  if is(mode = "complex") then "Enter numbers only, with no letters or variables."
  else if is(mode = "rational") then "Enter an integer or a fraction only: no letters, variables, square roots, decimals or i."
  else "Enter real numbers only, with no letters, variables or i.";

/* Is v a column vector c(...) with n entries? */
validate_la_vectorp(v, n) := member(safe_op(v), ["c", "column_vector"]) and ev(is(length(args(v)) = n), simp);

/* An example vector with n entries, starting at k: c(1,2,3). */
validate_la_example_vector(n, k) := sconcat("c(", simplode(map(string, ev(makelist(j, j, k, k+n-1), simp)), ","), ")");

/* A matrix of numbers. */
validate_la_matrix(ex, mode) := block([],
  if not(matrixp(ex)) then return("Your answer must be a matrix."),
  if not(validate_la_entriesp(flatten(args(ex)), mode)) then return(
    if is(mode = "complex") then "Enter a number in every entry of the matrix, with no letters or variables."
    else if is(mode = "rational") then "Enter an integer or a fraction in every entry of the matrix: no letters, variables, square roots, decimals or i."
    else "Enter a real number in every entry of the matrix, with no letters, variables or i."),
  "");

validate_nummat(ex) := validate_la_matrix(ex, "real");
validate_nummat_c(ex) := validate_la_matrix(ex, "complex");
validate_ratmat(ex) := validate_la_matrix(ex, "rational");

/* A set, or a list, of numbers.  The empty set and the empty list are valid. */
validate_la_numbers(ex, mode, isset) := block([],
  if isset and not(setp(ex)) then return("Enter a set in curly brackets, for example {2, -3}, or {} if it is empty."),
  if not(isset) and not(listp(ex)) then return("Enter a list in square brackets, for example [2, -3]."),
  if not(validate_la_entriesp(listify(ex), mode)) then return(validate_la_entries_msg(mode)),
  "");

validate_numset(ex) := validate_la_numbers(ex, "real", true);
validate_numset_c(ex) := validate_la_numbers(ex, "complex", true);
validate_numlist(ex) := validate_la_numbers(ex, "real", false);
validate_numlist_c(ex) := validate_la_numbers(ex, "complex", false);

/* A set, or a list, of column vectors c(...), each with n entries.  The empty set and the empty list are valid. */
validate_la_vectors(ex, n, mode, isset) := block([L, eg],
  eg: sconcat(validate_la_example_vector(n, 1), ", ", validate_la_example_vector(n, n+1)),
  if isset and not(setp(ex)) then return(sconcat("Enter a set of column vectors in curly brackets, for example {", eg, "}.")),
  if not(isset) and not(listp(ex)) then return(sconcat("Enter a list of column vectors in square brackets, in order, for example [", eg, "].")),
  L: listify(ex),
  if not(every(lambda([v], validate_la_vectorp(v, n)), L)) then
    return(sconcat("Write each vector as c(...) with ", n, if is(n = 1) then " entry" else " entries", ", for example ", validate_la_example_vector(n, 1), ".")),
  if not(validate_la_entriesp(flatten(map(args, L)), mode)) then return(validate_la_entries_msg(mode)),
  "");

validate_vecset(ex, n) := validate_la_vectors(ex, n, "real", true);
validate_vecset_c(ex, n) := validate_la_vectors(ex, n, "complex", true);
validate_veclist(ex, n) := validate_la_vectors(ex, n, "real", false);
validate_veclist_c(ex, n) := validate_la_vectors(ex, n, "complex", false);

/* An expression in the variables vars only, e.g. a linear map entered as formulas in x1, x2, x3. */
validate_la_vars(ex, vars, mode) := block([],
  if not(every(lambda([v], member(v, vars)), listofvars(ex))) then
    return(sconcat(if ev(is(length(vars) = 1), simp) then "Use only the variable " else "Use only the variables ", stack_disp_comma_separate(vars), ".")),
  if is(mode = "real") and not(freeof(%i, ev(ex, simp))) then return("Use real coefficients only, with no i."),
  "");

validate_vars(ex, vars) := validate_la_vars(ex, vars, "real");
validate_vars_c(ex, vars) := validate_la_vars(ex, vars, "complex");

/* A polynomial in the variables vars. */
validate_la_poly(ex, vars, mode) := block([ret],
  ret: validate_la_vars(ex, vars, mode),
  if not(is(ret = "")) then return(ret),
  if not(polynomialp(ev(expand(ex), simp), vars)) then
    return(sconcat("Enter a polynomial in ", stack_disp_comma_separate(vars), ".")),
  "");

validate_poly(ex, vars) := validate_la_poly(ex, vars, "real");
validate_poly_c(ex, vars) := validate_la_poly(ex, vars, "complex");
