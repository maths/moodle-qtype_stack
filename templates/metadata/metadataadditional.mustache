{{!
    @template qtype_stack/metadata/metadataadditional
    Example context (json):
        {
            "property": {
                "required": true,
                "element": {
                    "value": "h",
                    "wrapperid": "fitem_smdi_2_additional_property",
                    "id": "smdi_2_additional_property",
                    "name": "smdi_2_additional_property",
                    "iderror": "smde_2_additional_property_error"
                }
            },
            "qualifier": {
                "required": false,
                "element": {
                    "value": "i",
                    "wrapperid": "fitem_smdi_2_additional_qualifier",
                    "id": "smdi_2_additional_qualifier",
                    "name": "smdi_2_additional_qualifier",
                    "iderror": "smde_2_additional_qualifier_error"
                }
            },
            "value": {
                "required": false,
                "element": {
                    "value": "j",
                    "wrapperid": "fitem_smdi_2_additional_value",
                    "id": "smdi_2_additional_value",
                    "name": "smdi_2_additional_value",
                    "iderror": "smde_2_additional_value_error"
                }
            },
            "id": "2"
        }
}}
<div class="row align-items-start mb-2 smd-prop-row" id="qtype-stack-metadata-additional-{{{id}}}">
    <div class="col-md-3">
        <span class="smd-cell-text smd-read-mode">{{property.element.value}}</span>
        {{#property}}
            <label class="sr-only" for="{{element.id}}">
                {{#str}} additionalmetadata, qtype_stack {{/str}} {{#str}} property, qtype_stack {{/str}}
            </label>
            {{> core_form/element-text-inline }}
        {{/property}}
    </div>
    <div class="col-md-3">
        <span class="smd-cell-text smd-read-mode">{{qualifier.element.value}}</span>
        {{#qualifier}}
            <label class="sr-only" for="{{element.id}}">
                {{#str}} additionalmetadata, qtype_stack {{/str}} {{#str}} qualifier, qtype_stack {{/str}}
            </label>
            {{> core_form/element-text-inline }}
        {{/qualifier}}
    </div>
    <div class="col">
        <span class="smd-cell-text smd-read-mode">{{value.element.value}}</span>
        {{#value}}
            <label class="sr-only" for="{{element.id}}">
                {{#str}} additionalmetadata, qtype_stack {{/str}} {{#str}} value, qtype_stack {{/str}}
            </label>
            {{> core_form/element-text-inline }}
        {{/value}}
    </div>
    <div class="col-auto">
        <button id="smd_additional_{{id}}_delete" name="smd_delete" type="button"
                class="btn btn-link btn-sm text-danger smd-row-delete smd-edit-inline-flex align-items-center justify-content-center p-0"
                title="{{#str}} delete {{/str}} {{#str}} property, qtype_stack {{/str}}">
            <i class="fa fa-trash" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} delete {{/str}} {{#str}} property, qtype_stack {{/str}}</span>
        </button>
    </div>
</div>
