{{!
    @template qtype_stack/metadata/metadataauthor
    Example context (json):
        {
            "firstname": { "required": false, "element": { "value": "a", "wrapperid": "fitem_smdi_1_author_firstName", "id": "smdi_1_author_firstName", "name": "smdi_1_author_firstName", "iderror": "smde_1_author_firstName_error" } },
            "lastname":  { "required": true,  "element": { "value": "b", "wrapperid": "fitem_smdi_1_author_lastName",  "id": "smdi_1_author_lastName",  "name": "smdi_1_author_lastName",  "iderror": "smde_1_author_lastName_error"  } },
            "institution": { "required": false, "element": { "value": "c", "wrapperid": "fitem_smdi_1_author_institution", "id": "smdi_1_author_institution", "name": "smdi_1_author_institution", "iderror": "smde_1_author_institution_error" } },
            "year": { "required": false, "element": { "value": "2025", "wrapperid": "fitem_smdi_1_author_year", "id": "smdi_1_author_year", "name": "smdi_1_author_year", "iderror": "smde_1_author_year_error" } },
            "id": "1"
        }
}}
<div class="row align-items-start mb-2 smd-author-row" id="qtype-stack-metadata-author-{{{id}}}">
    {{! Read mode: compact one-line display + delete }}
    <div class="col smd-author-display smd-read-mode">
        <span class="smd-author-display-text">{{firstname.element.value}} {{lastname.element.value}}{{#institution.element.value}}{{#lastname.element.value}}, {{/lastname.element.value}}{{institution.element.value}}{{/institution.element.value}}{{#year.element.value}} ({{year.element.value}}){{/year.element.value}}</span>
    </div>
    {{! Edit mode: four input columns }}
    <div class="col-md smd-edit-block">
        {{#firstname}}
            <label class="sr-only" for="{{element.id}}">
                <span class="sr-only">{{#str}} author, qtype_stack {{/str}}</span> {{#str}} firstname, qtype_stack {{/str}}
            </label>
            {{> core_form/element-text-inline }}
        {{/firstname}}
    </div>
    <div class="col-md smd-edit-block">
        {{#lastname}}
            <label class="sr-only" for="{{element.id}}">
                <span class="sr-only">{{#str}} author, qtype_stack {{/str}}</span> {{#str}} lastname, qtype_stack {{/str}}
            </label>
            {{> core_form/element-text-inline }}
        {{/lastname}}
    </div>
    <div class="col-md smd-edit-block">
        {{#institution}}
            <label class="sr-only" for="{{element.id}}">
                <span class="sr-only">{{#str}} author, qtype_stack {{/str}}</span> {{#str}} institution, qtype_stack {{/str}}
            </label>
            {{> core_form/element-text-inline }}
        {{/institution}}
    </div>
    <div class="col-md smd-edit-block">
        {{#year}}
            <label class="sr-only" for="{{element.id}}">
                <span class="sr-only">{{#str}} author, qtype_stack {{/str}}</span> {{#str}} year, qtype_stack {{/str}}
            </label>
            {{>qtype_stack/metadata/metadatayear}}
        {{/year}}
    </div>
    <div class="col-auto">
        <button id="smd_author_{{id}}_delete" name="smd_delete" type="button"
                class="btn btn-link btn-sm text-danger smd-row-delete smd-edit-inline-flex align-items-center justify-content-center p-0"
                title="{{#str}} delete {{/str}} {{#str}} author, qtype_stack {{/str}}">
            <i class="fa fa-trash" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} delete {{/str}} {{#str}} author, qtype_stack {{/str}}</span>
        </button>
    </div>
</div>
