<form class="mform {{#isEditing}}smd-editing{{/isEditing}}" data-boost-form-errors-enhanced="1"
        id="qtype-stack-metadata-content">

    {{! Authors }}
    <div class="smd-section">
        <div class="smd-section-label">{{#str}} author, qtype_stack {{/str}}</div>
        {{#author.0}}
        <div class="row align-items-start mb-1 smd-field-header smd-edit-flex">
            <div class="col-md smd-col-label">{{#str}} firstname, qtype_stack {{/str}}</div>
            <div class="col-md smd-col-label">{{#str}} lastname, qtype_stack {{/str}}</div>
            <div class="col-md smd-col-label">{{#str}} institution, qtype_stack {{/str}}</div>
            <div class="col-md smd-col-label">{{#str}} year, qtype_stack {{/str}}</div>
            <div class="col-auto"></div>
        </div>
        {{/author.0}}
        {{#author}}
            {{>qtype_stack/metadata/metadataauthor}}
        {{/author}}
        <div class="gap-2 mt-2 smd-author-actions smd-edit-flex">
            <button class="btn btn-sm btn-outline-secondary" type="button" name="smd_add"
                    id="smd_author_0_add" title="{{#str}} addauthor, qtype_stack {{/str}}">
                <i class="fa fa-plus" aria-hidden="true"></i>
                <span class="sr-only">{{#str}} addauthor, qtype_stack {{/str}}</span>
            </button>
            <button class="btn btn-sm btn-outline-secondary" type="button"
                    id="stack-metadata-make-author" title="{{#str}} makemeauthor, qtype_stack {{/str}}">
                <i class="fa fa-user-plus" aria-hidden="true"></i>
                <span class="sr-only">{{#str}} makemeauthor, qtype_stack {{/str}}</span>
            </button>
        </div>
    </div>

    {{! Language }}
    <div class="smd-section">
        <div class="smd-section-label">{{#str}} language, core {{/str}}</div>
        {{#language}}
            {{>qtype_stack/metadata/metadatalanguage}}
        {{/language}}
        <div class="mt-2 smd-lang-actions smd-edit-block">
            <button type="button" class="btn btn-sm btn-outline-secondary" name="smd_add"
                    id="smd_language_0_add" title="{{#str}} addlanguage, qtype_stack {{/str}}">
                <i class="fa fa-plus" aria-hidden="true"></i>
                <span class="sr-only">{{#str}} addlanguage, qtype_stack {{/str}}</span>
            </button>
        </div>
    </div>

    {{! License + isPartOf }}
    <div class="smd-section">
        <div class="row">
            <div class="col-md-7" role="group" aria-labelledby="smd-license-label">
                <div class="smd-section-label" id="smd-license-label">{{#str}} license {{/str}}</div>
                <div class="smd-license-wrap d-flex align-items-center flex-wrap">
                    <span class="smd-license-display-text smd-read-mode">{{#license.element.options}}{{#selected}}{{text}}{{/selected}}{{/license.element.options}}</span>
                    {{#license}}
                        <label class="sr-only" for="{{element.id}}">{{#str}} license {{/str}}</label>
                        {{> core_form/element-autocomplete-inline}}
                    {{/license}}
                </div>
            </div>
            <div class="col-md-5 smd-col-divider">
                <div class="smd-section-label">{{#str}} ispartof, qtype_stack {{/str}}</div>
                <div class="smd-ispartof-wrap d-flex align-items-center flex-wrap">
                    <span class="smd-ispartof-display-text smd-read-mode">{{isPartOf.element.value}}</span>
                    {{#isPartOf}}
                        <label class="sr-only" for="{{element.id}}">{{#str}} ispartof, qtype_stack {{/str}}</label>
                        {{> core_form/element-text-inline}}
                    {{/isPartOf}}
                </div>
            </div>
        </div>
    </div>

    {{! Additional metadata }}
    <div class="smd-section">
        <div class="smd-section-label">{{#str}} additionalmetadata, qtype_stack {{/str}}</div>
        {{#scope}}
            {{>qtype_stack/metadata/metadatascope}}
        {{/scope}}
        <div class="mt-2 smd-scope-actions smd-edit-block">
            <button type="button" class="btn btn-sm btn-outline-secondary" name="smd_add"
                    id="smd_scope_0_add" title="{{#str}} addscope, qtype_stack {{/str}}">
                <i class="fa fa-plus" aria-hidden="true"></i>
                <span class="sr-only">{{#str}} addscope, qtype_stack {{/str}}</span>
            </button>
        </div>
    </div>

    {{! Freeform metadata }}
    <div class="smd-section">
        <div class="smd-section-label">{{#str}} freeformmetadata, qtype_stack {{/str}}</div>
        <pre class="smd-freeform-display-text smd-read-mode">{{freeform.element.value}}</pre>
        {{#freeform}}
            <label class="sr-only" for="{{element.id}}">
                {{#str}} freeformmetadata, qtype_stack {{/str}}
            </label>
            {{< core_form/element-template-inline }}
                {{$element}}
                    <textarea
                        id="{{element.id}}"
                        name="{{element.name}}"
                        class="form-control {{#error}}is-invalid{{/error}}"
                        {{#error}}
                            autofocus aria-describedby="{{element.iderror}}"
                        {{/error}}
                        {{{element.attributes}}}
                    >{{element.value}}</textarea>
                {{/element}}
            {{/ core_form/element-template-inline }}
        {{/freeform}}
    </div>

    {{! Utility buttons }}
    <div class="gap-2 flex-wrap mb-3 smd-utility-actions smd-edit-flex">
        <button class="btn btn-sm btn-secondary" type="button" id="stack-metadata-update">
            {{#str}} updateJSON, qtype_stack {{/str}}
        </button>
        <button class="btn btn-sm btn-secondary" type="button" id="stack-metadata-update-inputs">
            {{#str}} updateinputs, qtype_stack {{/str}}
        </button>
        <button class="btn btn-sm btn-secondary" type="button" id="stack-metadata-revert">
            {{#str}} reverttosaved, qtype_stack {{/str}}
        </button>
    </div>

    <p class="text-muted small smd-edit-block">
        {{#str}} metadataexplanation, qtype_stack {{/str}}
    </p>

    {{! JSON metadata — collapsible }}
    <details class="smd-section smd-json-section smd-edit-block"
            id="qtype-stack-metadata-json-section" {{#isJsonOpen}}open{{/isJsonOpen}}>
        <summary class="smd-section-label">
            {{#str}} JSONmetadata, qtype_stack {{/str}}
            <i class="fa fa-chevron-down fa-xs ms-1" aria-hidden="true"></i>
        </summary>
        <div class="mt-2">
            {{#json}}
                <label class="sr-only" for="{{element.id}}">
                    {{#str}} JSONmetadata, qtype_stack {{/str}}
                </label>
                {{< core_form/element-template-inline }}
                    {{$element}}
                        <textarea
                            id="{{element.id}}"
                            name="{{element.name}}"
                            class="form-control {{#error}}is-invalid{{/error}}"
                            {{#error}}
                                autofocus aria-describedby="{{element.iderror}}"
                            {{/error}}
                            {{#required}}
                                aria-required="true"
                            {{/required}}
                            {{{element.attributes}}}
                        >{{element.value}}</textarea>
                    {{/element}}
                {{/ core_form/element-template-inline }}
            {{/json}}
        </div>
    </details>

</form>
{{#js}}
require(['qtype_stack/metadata/metadatacontent'], function(component) {
    component.init('#qtype-stack-metadata-content');
});
{{/js}}
