{{!
    @template qtype_stack/metadata/metadatamodal

    Example context (json):  {}
}}
{{< core/modal }}
    {{$header}}
        <h5 id="{{uniqid}}-modal-title" class="modal-title text-truncate" data-region="title">
            {{#str}} metadata, qtype_stack {{/str}}
        </h5>
        <div class="custom-control custom-switch smd-header-edit">
            <input class="custom-control-input" type="checkbox" role="switch"
                    id="stack-metadata-edit-switch">
            <label class="custom-control-label" for="stack-metadata-edit-switch">
                {{#str}} edit {{/str}}
            </label>
        </div>
    {{/header}}
    {{$classes}}modal-xl stack-metadata{{/classes}}
    {{$body}}
        <div id="qtype-stack-metadata-main">
            <div data-for="qtype-stack-metadata">
            </div>
        </div>
    {{/body}}
    {{$footer}}
        <button type="button" class="btn btn-secondary" id="stackmetadata_cancel">{{#str}} cancel {{/str}}</button>
        <button type="button" class="btn btn-primary" id="stackmetadata_save">{{#str}} validateandclose, qtype_stack {{/str}}</button>
    {{/footer}}
{{/ core/modal }}
{{#js}}
require(['qtype_stack/metadata/container'], function(component) {
    component.init('#qtype-stack-metadata-main');
});
{{/js}}
