{{!
    @template qtype_stack/questionxmlcompare

    Displays Moodle XML comparison for two versions of a STACK question.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
      "question": {
        "currentversion": 2,
        "compareversion": 1
      },
      "displaymode": "unified",
      "displayunified": true,
      "displaysplit": false,
      "diffonly": false,
      "showalllines": true,
      "general": {
        "testquestionlink": "http://example.com",
        "previewquestionlink": "http://example.com",
        "editquestionlink": "http://example.com",
        "editxmllink": "http://example.com",
        "formaction": "http://example.com",
        "latestlink": "http://example.com",
        "displaytogglelink": "http://example.com",
        "diffonlytogglelink": "http://example.com",
        "isstackquestion": true,
        "formparams": [
          {"name": "id", "value": 1}
        ],
        "questionformparams": [
          {"name": "courseid", "value": 1}
        ]
      },
      "currentversions": [
        {"version": 2, "label": 2, "selected": true}
      ],
      "versions": [
        {"version": 1, "label": 1, "selected": true}
      ],
      "questionoptions": [
        {"id": 1, "label": "Question name (stack, v2)", "selected": true}
      ],
      "rows": [
        {
          "type": "same",
          "currentline": 1,
          "currentclass": "stack-xml-compare-code stack-xml-compare-code-current",
          "currenthtml": "&lt;quiz&gt;",
          "compareline": 1,
          "compareclass": "stack-xml-compare-code stack-xml-compare-code-compared",
          "comparehtml": "&lt;quiz&gt;"
        }
      ]
    }
}}

<div class="qtype_stack_question_report">
  <ul class="nav">
    {{#general.isstackquestion}}
      <li class="nav-item" role="presentation">
        <a class="nav-link" href="{{{general.testquestionlink}}}">
          <i class="fa fa-wrench"></i> {{#str}} runquestiontests, qtype_stack {{/str}}
        </a>
      </li>
    {{/general.isstackquestion}}
    <li class="nav-item" role="presentation">
      <a class="nav-link" href="{{{general.previewquestionlink}}}">
        <i class="fa fa-plus-circle"></i> {{#str}} questionpreview, qtype_stack {{/str}}
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link" href="{{{general.editquestionlink}}}">
        {{#str}} editquestioninthequestionbank, qtype_stack {{/str}}
      </a>
    </li>
    {{#general.isstackquestion}}
      <li class="nav-item" role="presentation">
        <a class="nav-link" href="{{{general.editxmllink}}}">{{#str}} editxml, qtype_stack {{/str}}</a>
      </li>
    {{/general.isstackquestion}}
  </ul>

  <h2>{{#str}} comparexmltitle, qtype_stack {{/str}}</h2>

  <form method="get" action="{{{general.formaction}}}" class="stack-xml-compare-controls">
    {{#general.questionformparams}}
      <input type="hidden" name="{{name}}" value="{{value}}">
    {{/general.questionformparams}}
    <label for="id_question">{{#str}} comparexmlselectquestion, qtype_stack {{/str}}</label>
    <select id="id_question" class="custom-select form-select" name="id" onchange="this.form.submit();">
      {{#questionoptions}}
        <option value="{{id}}" {{#selected}}selected="selected"{{/selected}}>{{label}}</option>
      {{/questionoptions}}
    </select>
  </form>

  {{#nootherversions}}
    <div class="alert alert-info">{{#str}} comparexmlnootherversions, qtype_stack {{/str}}</div>
  {{/nootherversions}}
  {{#hasnotices}}
    <div class="alert alert-warning">{{notices}}</div>
  {{/hasnotices}}

  <form method="get" action="{{{general.formaction}}}" class="stack-xml-compare-controls">
    {{#general.formparams}}
      <input type="hidden" name="{{name}}" value="{{value}}">
    {{/general.formparams}}
    <label for="id_currentversion">{{#str}} comparexmlselectcurrentversion, qtype_stack {{/str}}</label>
    <select id="id_currentversion" class="custom-select form-select"
        name="currentversion" onchange="this.form.submit();">
      {{#currentversions}}
        <option value="{{version}}" {{#selected}}selected="selected"{{/selected}}>{{label}}</option>
      {{/currentversions}}
    </select>
    <a class="btn btn-secondary" href="{{{general.latestlink}}}">
      {{#pix}}a/refresh, core{{/pix}}{{#str}} comparexmllatest, qtype_stack {{/str}}
    </a>
    <label for="id_compareversion">{{#str}} comparexmlselectversion, qtype_stack {{/str}}</label>
    <select id="id_compareversion" class="custom-select form-select"
        name="compareversion" onchange="this.form.submit();">
      {{#versions}}
        <option value="{{version}}" {{#selected}}selected="selected"{{/selected}}>{{label}}</option>
      {{/versions}}
    </select>
    <a class="btn btn-secondary" href="{{{general.displaytogglelink}}}">
      {{#displayunified}}{{#str}} comparexmlshowsplit, qtype_stack {{/str}}{{/displayunified}}
      {{#displaysplit}}{{#str}} comparexmlshowunified, qtype_stack {{/str}}{{/displaysplit}}
    </a>
    <a class="btn btn-secondary" href="{{{general.diffonlytogglelink}}}">
      {{#showalllines}}{{#str}} comparexmlshowdifferencesonly, qtype_stack {{/str}}{{/showalllines}}
      {{#diffonly}}{{#str}} comparexmlshowalllines, qtype_stack {{/str}}{{/diffonly}}
    </a>
  </form>

  <div class="stack-xml-compare-diff-wrap">
    <table class="stack-xml-compare-diff stack-xml-compare-diff-{{displaymode}}">
      <tbody>
        {{#rows}}
          <tr class="stack-xml-compare-row-{{type}}">
            {{#displayunified}}
              <td class="stack-xml-compare-line">{{currentline}}</td>
              <td class="stack-xml-compare-line">{{compareline}}</td>
              <td class="{{currentclass}}">
                <div class="stack-xml-compare-code-wrap">{{{currenthtml}}}</div>
              </td>
            {{/displayunified}}
            {{#displaysplit}}
              <td class="stack-xml-compare-line">{{currentline}}</td>
              <td class="{{currentclass}}">
                <div class="stack-xml-compare-code-wrap">{{{currenthtml}}}</div>
              </td>
              <td class="stack-xml-compare-line">{{compareline}}</td>
              <td class="{{compareclass}}">
                <div class="stack-xml-compare-code-wrap">{{{comparehtml}}}</div>
              </td>
            {{/displaysplit}}
          </tr>
        {{/rows}}
      </tbody>
    </table>
  </div>
</div>
